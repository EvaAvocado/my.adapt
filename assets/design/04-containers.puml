@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 140
title my.adapt — C4: диаграмма контейнеров
Person(player, "Игрок", "Первокурсник или абитуриент")
Person(visitor, "Посетитель сайта", "Знакомится с проектом и рейтингом")
System_Boundary(system, "my.adapt — ИТМО: Игра в адаптацию") {
  Container(app, "Мобильная игра", "Unity / C# / Android", "QR и ввод кода, панорамы, коллекция, достижения, локальный соперник и клиент рейтинга")
  ContainerDb(content, "Игровой контент", "Ресурсы Unity / ScriptableObject", "Локации, подсказки маршрутов, панорамы, предметы и карточки")
  ContainerDb(prefs, "Локальный прогресс", "Android / Unity PlayerPrefs", "Открытия, находки, коллекция и настройки")
  ContainerDb(identity, "Идентичность и pending", "JSON / persistentDataPath", "Постоянный playerId и один лучший неотправленный результат")
  Container(web, "Веб-интерфейс", "HTML / CSS / JavaScript в браузере", "Описание, скриншоты, ссылка на загрузку, публичный топ-10")
  Container(api, "Веб-сервис", "ASP.NET Core / Minimal API", "Выдача файлов сайта; проверка запросов и обработка рейтинга")
  ContainerDb(db, "База рейтинга", "SQLite", "До 1000 лучших результатов; одна запись на playerId")
}
System_Ext(download, "Хранилище APK", "Внешняя страница скачивания Android-версии")
Rel(player, app, "Играет и читает карточки", "Касания; камера устройства")
Rel(visitor, web, "Знакомится с проектом", "Браузер")
Rel(app, content, "Читает контент", "Локально [NFR-01]")
Rel(app, prefs, "Читает / сохраняет прогресс", "Локально [NFR-03]")
Rel(app, identity, "Читает / сохраняет UUID и pending", "Локально [FR-10]")
Rel(app, api, "Отправляет рекорд; читает топ и своё место", "HTTPS / JSON [FR-07, FR-08]")
Rel(web, api, "Загружает файлы сайта и публичный топ-10", "HTTPS [FR-09]")
Rel(web, download, "Открывает ссылку на скачивание", "HTTPS")
Rel(api, db, "Читает рейтинг; атомарно обновляет рекорд", "SQL / транзакция [NFR-04]")
SHOW_LEGEND()
@enduml

@startuml
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 14
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 140
skinparam linetype ortho
skinparam entityBackgroundColor #EEF7F5
skinparam entityBorderColor #286B62
hide circle
title Логическая ER-модель: контент, прогресс и рейтинг
entity "Корпус" as Building {
  * buildingId : ключ <<PK>>
  --
  название
  адрес
}
entity "Локация" as Location {
  * locationId : ключ <<PK>>
  --
  * buildingId : ключ <<FK>>
  название
  QR / четырёхзначный код
}
entity "Панорама" as Panorama {
  * panoramaId : ключ <<PK>>
  --
  * locationId : ключ <<FK>>
  имя / ресурс панорамы
}
entity "Размещение предмета" as Placement {
  * panoramaId : ключ <<PK, FK>>
  * itemKey : ключ <<PK, FK>>
}
entity "Предмет" as Item {
  * itemKey : ключ <<PK>>
  --
  название
  описание
  изображение
}
entity "Открытие локации" as Unlock {
  * playerId : ключ <<PK, FK>>
  * locationId : ключ <<PK, FK>>
}
entity "Локальный профиль" as Profile {
  * playerId : UUID <<PK>>
  --
  никнейм
}
entity "Находка в панораме" as Find {
  * playerId : ключ <<PK, FK>>
  * panoramaId : ключ <<PK, FK>>
  * itemKey : ключ <<PK, FK>>
}
entity "Запись коллекции" as Collection {
  * playerId : ключ <<PK, FK>>
  * itemKey : ключ <<PK, FK>>
  --
  * firstLocationId : ключ <<FK>>
  первое время находки
  карточка просмотрена
}
entity "Неотправленный результат" as Pending {
  * playerId : ключ <<PK, FK>>
  --
  никнейм для отправки
  timeMs : положительное целое
}
entity "Рекорд в рейтинге" as Score {
  * playerId : UUID <<PK>>
  --
  никнейм
  timeMs : положительное целое
  момент достижения
}
Building ||--|{ Location
Location ||--|{ Panorama
Panorama ||--|{ Placement
Item ||--|{ Placement
Profile ||--o{ Unlock
Location ||--o{ Unlock
Profile ||--o{ Find
Placement ||--o{ Find
Profile ||--o{ Collection
Item ||--o{ Collection
Location ||--o{ Collection
Profile ||--o| Pending
Profile ||..o| Score : единый playerId
legend bottom
  Контент: 3 корпуса, 20 локаций, 60 панорам, по 25 предметов.
  Всего 400 уникальных предметов в коллекции.
  Прогресс: PlayerPrefs; идентичность и pending: локальный JSON.
  Профиль локален устройству; облачной синхронизации коллекции нет.
endlegend
@enduml

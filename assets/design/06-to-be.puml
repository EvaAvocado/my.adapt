@startuml
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 140
skinparam activityBackgroundColor #EEF7F5
skinparam activityBorderColor #286B62
skinparam ArrowColor #40535B
title TO-BE — знакомство с корпусом с игрой my.adapt
start
:Возникла потребность найти аудиторию\nили узнать о возможностях корпуса;
:Открыть установленную игру;\nвыбрать корпус [FR-01];
note right
  Сайт предоставляет описание и установку [FR-09].
end note
repeat
  :Выбрать нужную локацию [FR-01];
  if (Локация ещё закрыта?) then (да)
    :Открыть её карточку и посмотреть\nскриншот маршрута из itmo.map [FR-01];
    :Прийти в корпус; пройти\nот входа до нужного помещения по подсказке;
    note right
      В AS-IS маршрут ищется в разных источниках.
      Здесь путь уже показан в карточке локации.
    end note
    :У нужного помещения сканировать QR\nили ввести четыре цифры [FR-02];
    :Снова открыть локацию;\nполучить доступ к трём панорамам;
  else (нет)
    :Открыть доступные панорамы;
  endif
  :Выбрать панораму и пройти поиск\n10 предметов [FR-03];
  :Изучить найденные предметы\nи информационные карточки [FR-04];
  note right
    Посещение дополняется сведениями
    о сервисах и возможностях университета.
  end note
  :Сохранить коллекцию и прогресс\nна телефоне [FR-05, NFR-03];
  note right
    Результат отдельных посещений накапливается;
    карточки доступны для повторного чтения.
  end note
  :Получить достижение при полном\nисследовании локации [FR-05];
repeat while (Есть ещё доступные локации\nи желание продолжить?) is (да) not (нет)
if (Выбран соревновательный раунд?) then (да)
  :Пройти раунд на время [FR-06];
  :Отправить результат в рейтинг\nили сохранить до появления сети [FR-07, FR-10];
  :Просмотреть общий рейтинг [FR-08];
else (нет)
endif
:Вернуться к коллекции\nи продолжить исследование позднее;
stop
@enduml

@startuml
!pragma layout smetana
skinparam defaultFontName Segoe UI
skinparam defaultFontSize 15
skinparam backgroundColor white
skinparam shadowing false
skinparam dpi 140
skinparam activityBackgroundColor #EEF7F5
skinparam activityBorderColor #286B62
skinparam ArrowColor #40535B
title Обычный режим: маршрут, открытие локации и коллекция
start
:Выбрать корпус и локацию\n[FR-01];
if (Локация открыта?) then (нет)
  :Показать скриншот itmo.map\nс маршрутом от входа к локации [FR-01];
  :Дойти до локации и таблички\nс QR-кодом и четырьмя цифрами;
  if (Выбран способ «Сканировать QR»?) then (да)
    if (Есть доступ к камере?) then (да)
      :Считать QR-код [FR-02];
    else (нет)
      :Показать сообщение о камере;\nпредоставить ручной ввод [NFR-06];
      :Ввести четыре цифры с таблички\n[FR-02];
    endif
  else (нет)
    :Ввести четыре цифры с таблички\n[FR-02];
  endif
  if (Получен корректный код\nизвестной локации?) then (да)
    :Сохранить открытие локации\nпо её ключу [NFR-03, NFR-04];
    :Повторно открыть карточку локации;\nпоказать три панорамы;
  else (нет)
    :Показать ошибку;\nвернуться к выбору локаций;
    stop
  endif
else (да)
endif
:Выбрать одну из трёх панорам;
:Сформировать 10 разных целей\nиз 25 предметов панорамы [FR-03];
note right
  Контент и прогресс хранятся на устройстве.
  Открытая локация доступна без сети [NFR-01].
end note
repeat
  :Найти предмет касанием экрана;
  if (Выбрана ещё не найденная\nцель текущего раунда?) then (да)
    :Отметить цель найденной;\nувеличить счётчик раунда;
    :Сохранить находку в панораме\nпо составному ключу [NFR-04];
    if (Предмет впервые найден\nв общей коллекции?) then (да)
      :Открыть карточку в коллекции;\nзаписать первое место и дату [FR-04];
    else (нет)
    endif
  else (нет)
    :Оставить счётчик без изменения;
  endif
repeat while (Найдено меньше 10 целей?) is (да) not (нет)
:Завершить раунд;\nобновить прогресс панорамы [FR-05];
if (Собраны все 25 предметов\nв каждой из трёх панорам локации?) then (да)
  :Открыть достижение локации [FR-05];
else (нет)
endif
:Открыть коллекцию и прочитать\nинформационные карточки [FR-04];
stop
@enduml
